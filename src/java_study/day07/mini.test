Ćwiczenia powtórkowe
1.
static void change(int a, int[] b) { metoda satyczna która nic nie zwraca dwa argumenty
      a = a * 2; kopia zmiennej a która nic nie zmienia w main dla podanej zmiennej
      b[0] = b[0] * 2; zmienia wartośc tablicy na indexie 0 mnoząc ja x2
}
// w main:
int x = 4; deklaracja inicjalizacja
int[] y = {4}; tablica długości
change(x, y); metoda
System.out.println(x + " " + y[0]); = 4 8

2.
static int doubleIt(int a) { metoda statyczna która zwraca int z jednym argumentem
    a = a * 2; mnożenie wartości a x2
    return a; zwracamy a
}
// w main:
int x = 4; deklaracja + inicjalizacja
doubleIt(x); nie wpływa na x
System.out.println(x); 4
x = doubleIt(x); tutaj nasza zmienna x zostaje nadpisana poprzez lidzbę zwracaną
System.out.println(x); 8

3.
for (int i = 2; i < 11; i += 2) { ... }
(i = 2 -> true -> i = i + 2)  i = 4
(i = 4 -> true -> i = i + 2)  i = 6
(i = 6 -> true -> i = i + 2)  i = 8
(i = 8 -> true -> i = i + 2)  i = 10
(i = 10 -> true -> i = i + 2) i = 12
(i = 12 -> false -> i = i + 2) koniec pętli

4.
int n = 20; deklaracja + inicjalizacja
int c = 0; deklaracja + inicjalizacja
while (n > 1) { pętla + warunek
    n = n / 2; 20 / 2 = 10 /1 iteracja(n = 10) -> 2 iteracja(n = 5) -> 3 iteracja(n = 2) -> 4 iteracja(n = 1) = false
    c++;                        c = 1                   c = 2               c = 3
}
System.out.println(n + " " + c); 2 3

